  "rules": [
    {
      "id": "C01",
      "name": "玩家阵营",
      "rule": "法师 士兵 友方商贩均为骷髅 丧尸 幽灵或其造物。骑手和坐骑均为死灵。活人只存在于敌方。"
    },
    {
      "id": "C02",
      "name": "出生阶级",
      "rule": "R1普通 R2精英 R3统领 R4领主。出生阶级由最终中奖盘面或明确消耗品修正规则决定 永不由经验升级。"
    },
    {
      "id": "C03",
      "name": "训练",
      "rule": "Lv1至Lv8只增强职业数值并在Lv4解锁一次二选一专精。每个职业从Lv1就有基础行为和被动。"
    },
    {
      "id": "C04",
      "name": "召唤谱系",
      "rule": "同家族R2和R3各有A/B两个职业 收兵时选择。树上的高阶节点表示可召唤的更高底子而非XP晋升路线。"
    },
    {
      "id": "C05",
      "name": "中奖",
      "rule": "九格独立抽样 三列依次停下。8线全部计入 同符号所有线合成只出一名该家族单位 不同符号分别结算。"
    },
    {
      "id": "C06",
      "name": "多线",
      "rule": "1线R1 Lv1 2线R2 Lv1 3线R3 Lv1 4线R4 Lv1 5线R4 Lv3 6线R4 Lv5 8线R4 Lv8。不存在7线盘面。"
    },
    {
      "id": "C07",
      "name": "抽取",
      "rule": "每波1次免费 付费追加基础上限3次费用3/5/8。遗物提高上限后第4/5次11/14。费用在抽取开始扣除。"
    },
    {
      "id": "C08",
      "name": "改盘",
      "rule": "停轮后是预览阶段 尚未发兵。最多两次已解锁干预 再统一确认结算一次。不能领兵后重摇或回档重抽。"
    },
    {
      "id": "C09",
      "name": "符号",
      "rule": "每局四个活跃家族 权重总20 每族2至10。更换家族继承原权重。已有单位不会随符号替换消失。"
    },
    {
      "id": "C10",
      "name": "军队",
      "rule": "正式上阵6 后备6。招募结果进入临时招募区 开战前必须处理完 不会因满员自动销毁大奖。"
    },
    {
      "id": "C11",
      "name": "献祭",
      "rule": "仅正式单位可在准备期被吸收。转移经验=阶级基础值加向下取整的75%已储存训练经验。阶级基础值2/5/12/25。供体删除 不能给自己献祭。"
    },
    {
      "id": "C12",
      "name": "换壳",
      "rule": "同家族的更高阶身体可与旧核心合魂。只留下新身体 职业技能和裸值以新身体为准 训练经验取两者较大值 不额外加献祭收益。重新选择新职业的Lv4专精。"
    },
    {
      "id": "C13",
      "name": "临时单位",
      "rule": "战斗技能产生的单位波后清除 不能进入后备 不能献祭 不产永久骨头或训练经验 不留下可复活尸体。"
    },
    {
      "id": "C14",
      "name": "死亡",
      "rule": "正式兵波后满血复起 永久保留职业和训练。管理献祭不触发死亡事件。法师受突破或超时压力扣命匣 不按友军死亡数计费。"
    },
    {
      "id": "C15",
      "name": "占领",
      "rule": "敌方全部被击败或突破后离场且命匣大于0算过波。普通/精英任一波60秒超时按剩余威胁扣血并撤退 无本波、后续波和占领奖励 仍正常选下一层。首领任一波超时直接结束本局；末波必须击杀首领，首领突破同样败局。每波累计命匣伤害上限20。"
    },
    {
      "id": "C16",
      "name": "骨头",
      "rule": "每波为固定遭遇预算 部分以击杀动画分配 通关/结算支付余量。召唤敌人和复活敌人不另产钱 每个波次只结算一次。"
    },
    {
      "id": "C17",
      "name": "遗物",
      "rule": "机器槽2至4 军团被动最多6。节点进入后配置锁定 直到节点完成或撤退；不允许先赌装抽再战装打。替换遗物无退款。"
    },
    {
      "id": "C18",
      "name": "路线",
      "rule": "三章每章五层：普通战 服务分叉 普通/精英分叉 事件/工坊分叉 城池首领。正常通关15节点27波。"
    },
    {
      "id": "C19",
      "name": "边界",
      "rule": "本版本不做多人 PvP 实时微操 网格式逐格寻路 全元素地表互相覆盖 装备耐久 独立装备词条。"
    }
  ],
  "events": [
    {
      "id": "BASIC_HIT",
      "name": "一次普通攻击有效命中",
      "rule": "每次普通攻击对主目标只发一次；顺劈旁支不再次算普攻命中"
    },
    {
      "id": "DIRECT_CRIT",
      "name": "可暴击直接伤害发生暴击",
      "rule": "技能须显式允许；持续伤害 反伤 事件派生伤害默认不发送"
    },
    {
      "id": "DAMAGE_TAKEN",
      "name": "伤害结算后实际受到损伤",
      "rule": "只在实际生命伤害大于0时发送；仍附带护盾伤害供日志。纯打盾不发送"
    },
    {
      "id": "EFFECTIVE_HEAL",
      "name": "实际恢复生命",
      "rule": "满血治疗为0不触发；转移生命/均分生命不是治疗"
    },
    {
      "id": "SHIELD_GAIN",
      "name": "实际增加护盾",
      "rule": "超过护盾上限的溢出不发事件；同一效果刷新时间不算新增"
    },
    {
      "id": "SHIELD_BREAK",
      "name": "伤害将正值护盾打到0",
      "rule": "自然到期 移除和管理操作不算打破"
    },
    {
      "id": "SUMMON",
      "name": "临时召唤成功落地",
      "rule": "达到上限未生成不发送；老虎机正式招募不属于战内SUMMON"
    },
    {
      "id": "ALLY_KO",
      "name": "一个友军本次生命归零且完成倒地",
      "rule": "同一生命只发一次；被致死保护救回不发；战内复活后可再次但受来源内置间隔"
    },
    {
      "id": "ENEMY_KO",
      "name": "敌人首次或再次倒地",
      "rule": "事件包含原生/召唤/复活标记；永久奖励仅原生首次"
    },
    {
      "id": "CORPSE_CONSUME",
      "name": "一个可用尸骸被消耗",
      "rule": "原子抢占 一具尸体只能给一个消费者；最近优先 距离并列按出生序号"
    },
    {
      "id": "POISON_TICK",
      "name": "中毒结算一次",
      "rule": "不会触发普攻 暴击和吸血；可由明确指定遗物监听"
    },
    {
      "id": "TAUNT",
      "name": "新嘲讽成功施加",
      "rule": "刷新同目标同来源不算新的TAUNT"
    },
    {
      "id": "DASH_END",
      "name": "一次冲锋完成",
      "rule": "被中断不发送完成；同一次冲锋最多一次"
    }
  ],
